# --- app ---
NODE_ENV=production
PORT=3000
# Public address of the site — the table QR codes encode <PUBLIC_BASE_URL>/order?table=N
PUBLIC_BASE_URL=https://ilchiosco.example.com

# --- database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ilchiosco
DATABASE_POOL_MAX=20

# --- staff logins ---
# Accounts are created with: STAFF_PASSWORD='…' npm run staff:add -- --username … --role waiter|manager
STAFF_SESSION_HOURS=12
# Browser origins allowed to call the API (comma separated), e.g. the GitHub Pages site
CORS_ORIGINS=https://nourabm33.github.io

# --- order queue ---
QUEUE_SCHEDULER_ENABLED=true
QUEUE_TICK_MS=2000

# Number of tables to seed / generate QR codes for
TABLE_COUNT=40

# --- POS / cassa integration ---
# simulation = nothing is sent to the till; released orders show as "Simulato"
#              (default until the POS technician provides the docs)
# http       = generic HTTP adapter using the settings below
POS_DRIVER=simulation
# simulation only: share of releases that fail (0–1), to rehearse error handling
POS_SIMULATION_FAILURE_RATE=0
POS_BASE_URL=
POS_API_KEY=
# bearer | basic | header
POS_AUTH_SCHEME=bearer
POS_ORDERS_PATH=/orders
POS_TIMEOUT_MS=8000
POS_WORKER_ENABLED=true
POS_WORKER_INTERVAL_MS=5000
POS_MAX_ATTEMPTS=10
